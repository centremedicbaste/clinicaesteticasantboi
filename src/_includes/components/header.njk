<header class="site-header" data-header>
  <div class="site-header__inner wrap">
    <a class="brand" href="/" aria-label="{{ global.empresa }} - Inicio">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
          <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="1"/>
          <path d="M13 24c2-7 5-9 7-9s5 2 7 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <circle cx="20" cy="14" r="2.5" fill="currentColor"/>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">Clínica Sant Boi</span>
        <span class="brand__sub">Medicina estética & dental</span>
      </span>
    </a>

    <nav class="nav-primary" aria-label="Navegación principal" data-nav>
      <ul class="nav-primary__list">
        {% for item in global.menu_principal %}
        <li class="nav-primary__item{% if item.submenu %} has-sub{% endif %}{% if page.url and (page.url == item.url or (item.url != '/' and page.url.indexOf(item.url) == 0)) %} is-active{% endif %}">
          <a href="{{ item.url }}" class="nav-primary__link">{{ item.label }}</a>
          {% if item.submenu %}
          <div class="nav-primary__sub" role="menu">
            <ul>
              {% for sub in item.submenu %}
              <li><a href="{{ sub.url }}" role="menuitem">{{ sub.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header-cta">
      <a href="tel:{{ global.telefono_link }}" class="header-cta__phone" aria-label="Llamar a la clínica">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{{ global.telefono_visible }}</span>
      </a>
      <a href="{{ global.cta_global.primary_link }}" class="btn btn--primary btn--sm">{{ global.cta_global.primary_label }}</a>
      <button class="hamburger" data-menu-toggle aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="site-header__mobile" data-mobile-menu hidden>
    <ul class="mobile-menu">
      {% for item in global.menu_principal %}
      <li>
        <a href="{{ item.url }}" class="mobile-menu__link">{{ item.label }}</a>
        {% if item.submenu %}
        <ul class="mobile-menu__sub">
          {% for sub in item.submenu %}<li><a href="{{ sub.url }}">{{ sub.label }}</a></li>{% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
      <li class="mobile-menu__cta">
        <a href="{{ global.cta_global.primary_link }}" class="btn btn--primary btn--block">{{ global.cta_global.primary_label }}</a>
        <a href="https://wa.me/{{ global.whatsapp }}" class="btn btn--ghost btn--block">{{ global.cta_global.secondary_label }}</a>
      </li>
    </ul>
  </div>
</header>
