---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ global.empresa }}",
  "short_name": "{{ global.empresa_corto }}",
  "description": "Medicina estética y odontología en {{ global.ciudad }}",
  "start_url": "/",
  "display": "standalone",
  "background_color": "{{ global.design_tokens.c_bg }}",
  "theme_color": "{{ global.design_tokens.c_accent }}",
  "icons": [
    { "src": "/assets/static/favicons/android-icon-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/static/favicons/android-icon-512x512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
